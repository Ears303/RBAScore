# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server only. Never expose this to the browser. Used by the API routes to write scores.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# PINs typed into the app. SCORER_PIN lets someone enter scores.
# ADMIN_PIN can also manage matches and entries (and can enter scores).
SCORER_PIN=change-me
ADMIN_PIN=change-me-too
